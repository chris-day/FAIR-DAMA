@prefix dama: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fair: <https://w3id.org/fair/principles/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:hasPart a owl:ObjectProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

dama:DMBOK2-2017 a owl:NamedIndividual,
        dama:FrameworkEdition ;
    rdfs:label "DAMA-DMBOK2 (2017)"@en ;
    dcterms:hasPart dama:DataArchitecture,
        dama:DataGovernance,
        dama:DataIntegrationAndInteroperability,
        dama:DataModelingAndDesign,
        dama:DataQualityManagement,
        dama:DataSecurity,
        dama:DataStorageAndOperations,
        dama:DataWarehousingAndBusinessIntelligence,
        dama:DocumentsAndContentManagement,
        dama:MetadataManagement,
        dama:ReferenceAndMasterDataManagement ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    dama:hasAdditionalTopic dama:BigDataAndDataScience,
        dama:DataHandlingEthics,
        dama:DataManagementMaturityAssessment .

dama:hasAdditionalTopic a owl:ObjectProperty ;
    rdfs:label "has additional topic"@en ;
    rdfs:domain dama:FrameworkEdition ;
    rdfs:range dama:AdditionalTopic .

<https://orcid.org/0000-0001-5095-7052> rdfs:label "Chris Day"@en .

dama:BigDataAndDataScience a owl:NamedIndividual,
        dama:AdditionalTopic ;
    rdfs:label "Big Data & Data Science"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md#13-big-data--data-science>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/13_BigDataDataScience.webp> ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Develop and operate data-driven analytical capabilities to investigate business questions, communicate insights and improve analytical models."@en .

dama:DataHandlingEthics a owl:NamedIndividual,
        dama:AdditionalTopic ;
    rdfs:label "Data Handling Ethics"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md#14-data-handling-ethics>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/01_DataHandlingEthics.webp> ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Establish, communicate and monitor acceptable data-handling practices to manage ethical risk and sustain responsible organizational behavior."@en .

dama:DataManagementMaturityAssessment a owl:NamedIndividual,
        dama:AdditionalTopic ;
    rdfs:label "Data Management Maturity Assessment"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md#12-data-management-maturity-assessment> ;
    skos:definition "Assess data management capabilities against a maturity framework and prioritize, plan and monitor improvements."@en .

dama:FrameworkEdition a owl:Class ;
    rdfs:label "Framework edition"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> .

dama:KnowledgeArea a owl:Class ;
    rdfs:label "Knowledge area"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    rdfs:subClassOf dama:ManagementTopic .

dama:ManagementTopic a owl:Class ;
    rdfs:label "Data management topic"@en .

dama:DataArchitecture a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Architecture"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Focuses on designing and maintaining the data structures and frameworks that support business strategy. This includes defining data models, selecting technologies, and ensuring data flows align with enterprise goals."@en .

dama:DataGovernance a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Governance"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Establishes policies, roles, and standards for managing data as a valuable business asset. It ensures compliance, accountability, and consistency across the organization."@en .

dama:DataIntegrationAndInteroperability a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Integration & Interoperability"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Enables the seamless flow of data across systems and platforms. This includes Extract, Transform, Load (ETL) processes, API-based integrations, and ensuring consistent data formats for operational efficiency."@en .

dama:DataModelingAndDesign a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Modeling & Design"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Develops structured representations of data to support business operations and analytics. It involves creating conceptual, logical, and physical data models that enable better data integration and usability."@en .

dama:DataQualityManagement a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Quality Management"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Ensures that data is accurate, complete, consistent, timely, valid, and unique. This includes defining data quality metrics, detecting errors, and implementing cleansing and enrichment strategies."@en .

dama:DataSecurity a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Security"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Protects data from unauthorized access, breaches, and loss. It encompasses access controls, encryption, regulatory compliance, and security policies to safeguard sensitive information."@en .

dama:DataStorageAndOperations a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Storage & Operations"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Ensures data is efficiently stored, retrieved, and maintained. This includes managing databases, implementing backup and recovery solutions, and optimizing data performance."@en .

dama:DataWarehousingAndBusinessIntelligence a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Data Warehousing & Business Intelligence"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Supports analytics, reporting, and decision-making by organizing data for easy access. It involves designing data warehouses, data lakes, and business intelligence (BI) tools to enable strategic insights."@en .

dama:DocumentsAndContentManagement a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Documents & Content Management"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Manages unstructured data such as documents, images, videos, and other content. This area ensures that digital assets are properly stored, categorized, and accessed according to business needs."@en .

dama:MetadataManagement a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Metadata Management"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Maintains “data about data” to improve understanding, governance, and accessibility. Metadata catalogs help organizations track data lineage, definitions, and usage across different systems."@en .

dama:ReferenceAndMasterDataManagement a owl:NamedIndividual,
        dama:DMBOK2-2017-KnowledgeArea ;
    rdfs:label "Reference & Master Data Management"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    skos:definition "Ensures consistency in core data entities like customers, products, and locations across business units. Master Data Management (MDM) and Reference Data Management provide a “single source of truth” for key business information."@en .

dama:AdditionalTopic a owl:Class ;
    rdfs:label "Additional DMBOK topic"@en ;
    rdfs:subClassOf dama:ManagementTopic ;
    owl:disjointWith dama:KnowledgeArea .

dama:DMBOK2-2017-KnowledgeArea a owl:Class ;
    rdfs:label "DAMA-DMBOK2 (2017) knowledge area"@en ;
    rdfs:isDefinedBy <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> ;
    rdfs:subClassOf dama:KnowledgeArea ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( dama:DataGovernance dama:DataArchitecture dama:DataModelingAndDesign dama:DataStorageAndOperations dama:DataSecurity dama:DataIntegrationAndInteroperability dama:DocumentsAndContentManagement dama:ReferenceAndMasterDataManagement dama:DataWarehousingAndBusinessIntelligence dama:MetadataManagement dama:DataQualityManagement ) ] .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-5095-7052> ;
    dcterms:description "The eleven core DAMA-DMBOK2 knowledge areas and three explicitly separate supporting topics. The core enumeration remains unchanged."@en ;
    dcterms:modified "2026-11-16"^^xsd:date ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md>,
        fair:FAIR-Vocabulary ;
    dcterms:title "DAMA Knowledge Areas Vocabulary"@en ;
    owl:versionInfo "1.1.0" .

[] a owl:AllDifferent ;
    owl:distinctMembers ( dama:BigDataAndDataScience dama:DataHandlingEthics dama:DataManagementMaturityAssessment ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( dama:DataGovernance dama:DataArchitecture dama:DataModelingAndDesign dama:DataStorageAndOperations dama:DataSecurity dama:DataIntegrationAndInteroperability dama:DocumentsAndContentManagement dama:ReferenceAndMasterDataManagement dama:DataWarehousingAndBusinessIntelligence dama:MetadataManagement dama:DataQualityManagement ) .
