    map:indirectSupportExplanation "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    map:lifecycleCode "D"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-partners>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists> ;
    map:relevantDeliverables "Data Insights and Findings"@en ;
    map:sourceRow 8 ;
    map:sourceWorksheet "BigDataDataScience" .

