<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Establish Big Data Environments"@en ;
    dcterms:identifier "BigDataDataScience!A3:L3" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Big Data Landscape; Operations Plan"@en ;
    map:directSupportExplanation "A deployed platform, database or cloud service does not establish identifier-based retrieval or an open protocol."@en ;
    map:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:inTopic dama:BigDataAndDataScience ;
    map:indirectSupportExplanation "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    map:lifecycleCode "D"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    map:relevantDeliverables "Big Data Landscape; Operations Plan"@en ;
    map:sourceRow 3 ;
    map:sourceWorksheet "BigDataDataScience" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Integrate/Align Data For Analysis"@en ;
    dcterms:identifier "BigDataDataScience!A7:L7" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Data Analysis and Hypotheses"@en ;
    map:directSupportExplanation "Joining datasets or aligning statistical features does not by itself establish a shared knowledge-representation language or qualified resource references."@en ;
    map:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    map:inTopic dama:BigDataAndDataScience ;
    map:indirectSupportExplanation "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    map:lifecycleCode "D"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-curators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-smes>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/metadata-specialists> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/ingestion-architects> ;
    map:relevantDeliverables "Data Analysis and Hypotheses"@en ;
    map:sourceRow 7 ;
    map:sourceWorksheet "BigDataDataScience" .

map:DirectContribution a owl:Class ;
    rdfs:label "Direct contribution"@en ;
    rdfs:comment "The source practice produces or verifies evidence addressing the target FAIR subprinciple."@en .

map:PublishProvenance a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Publish detailed dataset provenance"@en ;
    map:evidenceForPrinciple fair:R1.2 ;
    map:inKnowledgeArea dama:MetadataManagement .

map:AttachUsageLicense a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Attach a usage license to the published data or metadata"@en ;
    map:evidenceForPrinciple fair:R1.1 ;
    map:inKnowledgeArea dama:MetadataManagement .

map:ConfigureRetrievalAuthorization a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Configure authentication and authorization for retrieval"@en ;
    map:evidenceForPrinciple fair:A1.2 ;
    map:inKnowledgeArea dama:DataSecurity .

map:SourceActivity a owl:Class ;
    rdfs:label "Source activity"@en ;
    rdfs:subClassOf map:Practice .

map:Practice a owl:Class ;
    rdfs:label "DAMA-related practice"@en .

map:IndirectContribution a owl:Class ;
    rdfs:label "Indirect contribution"@en ;
    rdfs:comment "The source practice enables an intermediate practice that provides or verifies the evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty map:viaPractice ;
            owl:someValuesFrom map:Practice ] .

map:AreaAlignmentAssessment a owl:Class ;
    rdfs:label "Proposed area-to-FAIR alignment assessment"@en ;
    owl:disjointWith map:FAIRContribution .
