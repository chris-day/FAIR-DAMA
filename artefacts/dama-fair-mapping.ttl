    map:alignmentType "Enabling" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Approved representation languages; semantic architecture; interoperability patterns."@en ;
    map:fromTopic dama:DataArchitecture ;
    map:rationale "Establish enterprise conventions for knowledge representation."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-governance/enabling/A1.1> a owl:NamedIndividual,
