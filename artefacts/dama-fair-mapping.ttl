map:deliverables a owl:AnnotationProperty ;
    rdfs:label "deliverables"@en .

map:derivedFromActivity a owl:ObjectProperty ;
    rdfs:label "derived from source activity"@en ;
    rdfs:domain map:AreaAlignmentAssessment ;
    rdfs:range map:SourceActivity .

map:directSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "direct support explanation"@en .

map:evidenceForPrinciple a owl:ObjectProperty ;
    rdfs:label "provides evidence for principle"@en ;
    rdfs:domain map:Practice ;
    rdfs:range fair:FAIR-SubPrinciple .

map:evidenceRequirement a owl:AnnotationProperty ;
    rdfs:label "evidence requirement"@en .

map:fromTopic a owl:ObjectProperty ;
    rdfs:label "from management topic"@en ;
    rdfs:domain map:AreaAlignmentAssessment ;
    rdfs:range dama:ManagementTopic .

map:inKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain map:Practice ;
    rdfs:range dama:KnowledgeArea ;
    rdfs:subPropertyOf map:inTopic .

map:indirectSupportExplanation a owl:AnnotationProperty ;
    rdfs:label "indirect support explanation"@en .

map:lifecycleCode a owl:AnnotationProperty ;
    rdfs:label "lifecycle code"@en .

map:proposedApprovingPersona a owl:ObjectProperty ;
    rdfs:label "proposed approving persona"@en ;
    rdfs:domain map:SourceActivity ;
    rdfs:range persona:Persona .

map:proposedContributingPersona a owl:ObjectProperty ;
    rdfs:label "proposed contributing persona"@en ;
    rdfs:domain map:SourceActivity ;
    rdfs:range persona:Persona .

map:proposedResponsiblePersona a owl:ObjectProperty ;
    rdfs:label "proposed responsible persona"@en ;
    rdfs:domain map:SourceActivity ;
    rdfs:range persona:Persona .

map:rationale a owl:AnnotationProperty .

map:relevantDeliverables a owl:AnnotationProperty ;
    rdfs:label "relevant deliverables"@en .

map:sourceRow a owl:AnnotationProperty ;
    rdfs:label "source row"@en .

map:sourceWorksheet a owl:AnnotationProperty ;
    rdfs:label "source worksheet"@en .

map:AssignProvenanceResponsibility a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Assign responsibility for documenting provenance"@en ;
    map:inKnowledgeArea dama:DataGovernance .

map:ImplementOpenRetrievalProtocol a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Implement an open, free, universally implementable retrieval protocol"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:A1.1 ;
    map:inKnowledgeArea dama:DataIntegrationAndInteroperability .

map:IncludeDatasetIdentifier a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Include the dataset identifier in its metadata"@en ;
    map:inKnowledgeArea dama:MetadataManagement .

map:IndexInSearchableCatalog a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Index data or metadata in a searchable catalog"@en ;
    map:inKnowledgeArea dama:MetadataManagement .

map:PublishQualifiedResourceReferences a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Publish explicit typed references to related identified resources"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:I3 ;
    map:inKnowledgeArea dama:MetadataManagement .

map:SetDataSecurityPolicy a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Set a data security policy"@en ;
    map:inKnowledgeArea dama:DataSecurity .

map:SetLicensingPolicy a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Set a data licensing policy"@en ;
    map:inKnowledgeArea dama:DataGovernance .

map:ValidateCommunityStandards a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Validate resources against applicable domain community standards"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:R1.3 ;
    map:inKnowledgeArea dama:DataQualityManagement .

map:fromPractice a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain map:FAIRContribution ;
    rdfs:range map:Practice .

map:inTopic a owl:ObjectProperty ;
    rdfs:label "in management topic"@en ;
    rdfs:domain map:Practice ;
    rdfs:range dama:ManagementTopic .

map:targetsPrinciple a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain map:FAIRContribution ;
    rdfs:range fair:FAIR-SubPrinciple .

map:viaPractice a owl:ObjectProperty ;
    rdfs:domain map:IndirectContribution ;
    rdfs:range map:Practice .

<https://orcid.org/0000-0001-5095-7052> rdfs:label "Chris Day"@en .

map:EnableIdentifierBasedRetrieval a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Implement retrieval by identifier through a standardized protocol"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:A1 ;
    map:inKnowledgeArea dama:DataIntegrationAndInteroperability .

map:PublishRichDiscoveryMetadata a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Publish rich resource discovery descriptions"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:F2 ;
    map:inKnowledgeArea dama:MetadataManagement .

map:PublishRichReuseDescriptions a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Publish accurate and relevant resource descriptions for reuse"@en ;
    map:assessmentStatus "Proposed evidence-producing practice; implementation not asserted"@en ;
    map:evidenceForPrinciple fair:R1 ;
    map:inKnowledgeArea dama:MetadataManagement .

map:PublishSharedRepresentation a owl:NamedIndividual,
        map:Practice ;
    rdfs:label "Publish data or metadata in a shared representation"@en ;
    map:evidenceForPrinciple fair:I1 ;
    map:inKnowledgeArea dama:DataIntegrationAndInteroperability .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Define Big Data Strategy & Business Needs"@en ;
    dcterms:identifier "BigDataDataScience!A2:L2" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A2:L2> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Big Data Strategy & Standards"@en ;
    map:directSupportExplanation "A strategy is an enabling decision record; it does not itself establish FAIR properties of data or metadata."@en ;
    map:evidenceRequirement "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    map:inTopic dama:BigDataAndDataScience ;
    map:indirectSupportExplanation "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en ;
    map:lifecycleCode "P"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/it-executives> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-quality-and-governance-specialists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-scientists>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/information-consumers> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/analytic-design-lead>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/big-data-platform-architects> ;
    map:relevantDeliverables "Big Data Strategy & Standards"@en ;
    map:sourceRow 2 ;
    map:sourceWorksheet "BigDataDataScience" .

map:FAIRContribution a owl:Class ;
    rdfs:label "FAIR contribution assertion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty map:fromPractice ;
            owl:someValuesFrom map:Practice ],
        [ a owl:Restriction ;
            owl:onProperty map:targetsPrinciple ;
            owl:someValuesFrom fair:FAIR-SubPrinciple ] ;
    owl:disjointUnionOf ( map:DirectContribution map:IndirectContribution ) .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Deploy and Monitor"@en ;
    dcterms:identifier "BigDataDataScience!A10:L10" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/13_BigDataDataScience.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    map:directSupportExplanation "Deployment, availability and model performance do not directly establish a FAIR principle."@en ;
    map:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    map:inTopic dama:BigDataAndDataScience ;
    map:indirectSupportExplanation "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    map:lifecycleCode "O,C"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/business-executives>,
