    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:R1 ;
    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Indirect" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Data Insights and Findings"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources. Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1.1 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:R1.1 ;
    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Indirect" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Data Sourcing Plan"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.2> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1.2 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:R1.2 ;
    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Indirect" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Data Sourcing Plan; Acquired Data Sources; Data Analysis and Hypotheses; Data Insights and Findings; Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained. Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement. Versioned methods and input records can enable provenance when linked to the resulting data and model outputs. Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design. Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/R1.3> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1.3 (Indirect)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:R1.3 ;
    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Indirect" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Big Data Strategy & Standards"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-architecture/enabling/A1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
