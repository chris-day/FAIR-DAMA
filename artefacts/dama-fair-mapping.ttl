<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/reference-master-data-management/direct/F1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Reference & Master Data Management → F1 (Direct)"@en ;
