<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-10/indirect/A1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Deploy and Monitor → A1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> ;
    map:rationale "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    map:targetsPrinciple fair:A1 ;
    map:viaPractice map:EnableIdentifierBasedRetrieval .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-10/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Deploy and Monitor → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A10:L10> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Test standardized retrieval of identified resources and inspect version-linked deployment and execution provenance. Monitoring predictive accuracy or infrastructure utilization alone is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10> ;
    map:rationale "Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-2/indirect/R1.3> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Define Big Data Strategy & Business Needs → R1.3"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A2:L2> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect approved standards and their domain relevance, then validate actual data and metadata against the applicable community specifications. Strategy approval alone does not demonstrate conformance."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-2> ;
    map:rationale "Standards selection can commission domain-relevant community conformance if named external standards, versions and acceptance tests are explicitly adopted. Internal IT standards alone are insufficient."@en ;
    map:targetsPrinciple fair:R1.3 ;
    map:viaPractice map:ValidateCommunityStandards .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-3/indirect/A1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Establish Big Data Environments → A1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    map:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    map:targetsPrinciple fair:A1 ;
    map:viaPractice map:EnableIdentifierBasedRetrieval .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-3/indirect/A1.1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Establish Big Data Environments → A1.1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    map:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    map:targetsPrinciple fair:A1.1 ;
    map:viaPractice map:ImplementOpenRetrievalProtocol .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-3/indirect/A1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Establish Big Data Environments → A1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A3:L3> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Test retrieval of identified data and metadata through a specified standard protocol; inspect freely implementable protocol specifications; test required authentication and authorization. Platform availability alone is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    map:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented."@en ;
    map:targetsPrinciple fair:A1.2 ;
    map:viaPractice map:ConfigureRetrievalAuthorization .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Choose Data Sources → R1.1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    map:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    map:targetsPrinciple fair:R1.1 ;
    map:viaPractice map:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-4/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Choose Data Sources → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A4:L4> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Trace selected source versions to providers and acquisition context; inspect accessible usage licences linked to each resource. A commercial purchase or access agreement alone is not a FAIR usage licence."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-4> ;
    map:rationale "Source evaluation can record origin, permitted reuse and descriptive context, enabling provenance and licensing requirements when resource-linked records and accessible terms are retained."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-5/indirect/F2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Acquire & Ingest Data Sources → F2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> ;
    map:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    map:targetsPrinciple fair:F2 ;
    map:viaPractice map:PublishRichDiscoveryMetadata .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-5/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Acquire & Ingest Data Sources → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A5:L5> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect descriptions linked to ingested resources and provenance records identifying sources, versions, agents, acquisition times and transformations. Successful loading and scanning alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-5> ;
    map:rationale "Ingestion can capture resource descriptions, source versions, acquisition times and transformations if metadata capture is added as an explicit requirement."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-6/direct/R1> a owl:NamedIndividual,
        map:DirectContribution ;
    rdfs:label "Develop Hypotheses & Methods → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A6:L6> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    map:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en ;
    map:targetsPrinciple fair:R1 .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-6/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Develop Hypotheses & Methods → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A6:L6> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "For R1, inspect resource-linked descriptions of hypotheses, methods, assumptions, units, scope and limitations, and verify their accuracy and relevance for reuse. For R1.2, additionally inspect input versions, methods, agents and execution history. An unexplained model or hypothesis list is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    map:rationale "Versioned methods and input records can enable provenance when linked to the resulting data and model outputs."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/I1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Integrate/Align Data For Analysis → I1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    map:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    map:targetsPrinciple fair:I1 ;
    map:viaPractice map:PublishSharedRepresentation .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/I3> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Integrate/Align Data For Analysis → I3"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A7:L7> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect shared formal representations and identifiable resources with typed relations; trace transformations to source versions. Matching columns, feature vectors and internal keys alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-7> ;
    map:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    map:targetsPrinciple fair:I3 ;
    map:viaPractice map:PublishQualifiedResourceReferences .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-7/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
