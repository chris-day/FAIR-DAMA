<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-2> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Review Data-Handling Practices"@en ;
    dcterms:identifier "DataHandlingEthics!A2:L2" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A2:L2> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Current Practices and Gaps"@en ;
    map:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    map:evidenceRequirement "Inspect approved policy or control requirements that explicitly distinguish access authorization from permitted reuse. Test any resulting authentication and authorization procedure for identified resources (A1.2) and inspect the clear, accessible usage licence attached to data and metadata (R1.1). An ethics statement, privacy notice or generic compliance metric alone is insufficient."@en ;
    map:inTopic dama:DataHandlingEthics ;
    map:indirectSupportExplanation "Review can identify gaps in authorized access and permitted reuse if the review criteria explicitly include them."@en ;
    map:lifecycleCode "P"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-providers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/regulators>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    map:relevantDeliverables "Current Practices and Gaps"@en ;
    map:sourceRow 2 ;
    map:sourceWorksheet "DataHandlingEthics" .

