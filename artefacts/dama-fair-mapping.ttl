    map:alignedPrinciple fair:R1.3 ;
    map:alignmentBasis "Implementation-oriented proposal (11 core areas)"@en ;
    map:alignmentType "Direct" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Community metadata profiles; required descriptive elements; conformance declarations."@en ;
    map:fromTopic dama:MetadataManagement ;
