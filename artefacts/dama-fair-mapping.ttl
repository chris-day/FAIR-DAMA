    map:alignedPrinciple fair:A1 ;
    map:alignmentBasis "Implementation-oriented proposal (11 core areas)"@en ;
    map:alignmentType "Enabling" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Access architecture; endpoint conventions; service contracts."@en ;
    map:fromTopic dama:DataArchitecture ;
    map:rationale "Define how identifiers, resolvers and retrieval services work together."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-architecture/enabling/A1.1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Data Architecture → A1.1 (Enabling)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:A1.1 ;
    map:alignmentBasis "Implementation-oriented proposal (11 core areas)"@en ;
    map:alignmentType "Enabling" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Approved protocol catalog; protocol-selection criteria; interoperability architecture."@en ;
    map:fromTopic dama:DataArchitecture ;
    map:rationale "Select protocols without proprietary implementation dependencies."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/data-architecture/enabling/I1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Data Architecture → I1 (Enabling)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:I1 ;
