    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Indirect" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Big Data Landscape; Operations Plan; Model Performance; Model Enhancement Plan"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-10>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-3> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Platform design can enable standardized retrieval, open protocols and controlled access if these are explicitly commissioned and implemented. Operations can sustain identifier-based access and record versioned inputs, model changes and execution history when those controls are explicitly included in the operations plan."@en .

