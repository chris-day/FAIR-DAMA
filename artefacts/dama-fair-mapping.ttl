    map:relevantDeliverables "Updated Policies"@en ;
    map:sourceRow 5 ;
    map:sourceWorksheet "DataHandlingEthics" .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-7> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Implement Risk Mitigation"@en ;
