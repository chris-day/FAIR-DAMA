    map:alignmentBasis "Implementation-oriented proposal (11 core areas)"@en ;
    map:alignmentType "Direct" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Governed namespaces; identifier crosswalks; non-reassignment rules. Internal keys alone do not establish global uniqueness or persistence."@en ;
    map:fromTopic dama:ReferenceAndMasterDataManagement ;
    map:rationale "Maintain stable entity identifiers and mappings between identifier systems."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/reference-master-data-management/direct/I2> a owl:NamedIndividual,
