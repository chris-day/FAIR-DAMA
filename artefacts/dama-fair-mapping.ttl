@prefix dama: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fair: <https://w3id.org/fair/principles/terms/> .
@prefix map: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix persona: <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-5095-7052> ;
    dcterms:modified "2026-11-16"^^xsd:date ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_Segments_High_Level_v1.18.0.md>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-ontology.ttl>,
        fair:FAIR-Vocabulary ;
    dcterms:title "DAMA to FAIR Contribution Ontology"@en ;
    owl:versionInfo "1.1.0" .

map:AssignProvenanceResponsibilityToR1_2 a owl:NamedIndividual,
        map:IndirectContribution ;
    dcterms:source dama:DataGovernance,
        fair:R1.2 ;
    map:fromPractice map:AssignProvenanceResponsibility ;
    map:rationale "Assigning responsibility enables the publication of detailed dataset provenance."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

map:AttachUsageLicenseToR1_1 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:MetadataManagement,
        fair:R1.1 ;
    map:applicabilityCondition "The license applies to the resource and is clear and accessible."@en ;
    map:fromPractice map:AttachUsageLicense ;
    map:rationale "The published license states the terms under which the data or metadata may be used."@en ;
    map:targetsPrinciple fair:R1.1 .

map:ConfigureRetrievalAuthorizationToA1_2 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:DataSecurity,
        fair:A1.2 ;
    map:applicabilityCondition "Access control is needed and the retrieval protocol supports both authentication and authorization."@en ;
    map:fromPractice map:ConfigureRetrievalAuthorization ;
    map:rationale "The retrieval configuration provides evidence that the protocol supports authentication and authorization."@en ;
    map:targetsPrinciple fair:A1.2 .

map:IncludeDatasetIdentifierToF3 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:MetadataManagement,
        fair:F3 ;
    map:applicabilityCondition "The identifier in the metadata is the identifier of the described data."@en ;
    map:fromPractice map:IncludeDatasetIdentifier ;
    map:rationale "The metadata record explicitly identifies the data it describes."@en ;
    map:targetsPrinciple fair:F3 .

map:IndexInSearchableCatalogToF4 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:MetadataManagement,
        fair:F4 ;
    map:applicabilityCondition "The catalog is searchable and contains an index entry for the relevant data or metadata."@en ;
    map:fromPractice map:IndexInSearchableCatalog ;
    map:rationale "A searchable catalog entry provides evidence that the data or metadata have been indexed."@en ;
    map:targetsPrinciple fair:F4 .

map:PublishProvenanceToR1_2 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:MetadataManagement,
        fair:R1.2 ;
    map:applicabilityCondition "Detailed provenance is associated with the data or metadata."@en ;
    map:fromPractice map:PublishProvenance ;
    map:rationale "The provenance record provides evidence about the origins and history of the data."@en ;
    map:targetsPrinciple fair:R1.2 .

map:PublishSharedRepresentationToI1 a owl:NamedIndividual,
        map:DirectContribution ;
    dcterms:source dama:DataIntegrationAndInteroperability,
        fair:I1 ;
    map:applicabilityCondition "The language is formal, accessible, shared and broadly applicable."@en ;
    map:fromPractice map:PublishSharedRepresentation ;
    map:rationale "The published representation provides evidence of the knowledge representation language used."@en ;
    map:targetsPrinciple fair:I1 .

map:SetDataSecurityPolicyToA1_2 a owl:NamedIndividual,
        map:IndirectContribution ;
    dcterms:source dama:DataSecurity,
        fair:A1.2 ;
    map:applicabilityCondition "The policy applies to the retrieval service and calls for authentication and authorization where needed."@en ;
    map:fromPractice map:SetDataSecurityPolicy ;
    map:rationale "The policy drives the configuration of authentication and authorization for data or metadata retrieval."@en ;
    map:targetsPrinciple fair:A1.2 ;
    map:viaPractice map:ConfigureRetrievalAuthorization .

map:SetLicensingPolicyToR1_1 a owl:NamedIndividual,
        map:IndirectContribution ;
    dcterms:source dama:DataGovernance,
        fair:R1.1 ;
    map:fromPractice map:SetLicensingPolicy ;
    map:rationale "The policy enables a publishing practice that attaches the applicable usage license."@en ;
    map:targetsPrinciple fair:R1.1 ;
    map:viaPractice map:AttachUsageLicense .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-6> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Execute the Training and Communications Plan"@en ;
    dcterms:identifier "DataHandlingEthics!A6:L6" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A6:L6> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    map:directSupportExplanation "No direct FAIR requirement is established by this ethical-practice activity or its named deliverables. Ethical responsibility and FAIR fulfilment are related but distinct."@en ;
    map:evidenceRequirement "Inspect training objectives, materials and attendance as process evidence. Before assigning any FAIR ID, identify explicit FAIR requirements taught and separately test their implementation on resources. Training completion alone does not demonstrate FAIR fulfilment."@en ;
    map:inTopic dama:DataHandlingEthics ;
    map:indirectSupportExplanation "Training and communications can improve ethical behavior and awareness, but the image supplies no principle-specific training content."@en ;
    map:lifecycleCode "D"@en ;
    map:proposedApprovingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/data-governance-bodies> ;
    map:proposedContributingPersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/coordinating-data-stewards>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/employees>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/executives>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/subject-matter-experts> ;
    map:proposedResponsiblePersona <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/change-managers>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-persona-ontology.ttl#profile/dm-services> ;
    map:relevantDeliverables "Communication Plan; Ethics Training Program; Awareness to Ethical Data Issues"@en ;
    map:sourceRow 6 ;
    map:sourceWorksheet "DataHandlingEthics" .

map:alignedPrinciple a owl:ObjectProperty ;
    rdfs:label "aligned FAIR principle"@en ;
    rdfs:domain map:AreaAlignmentAssessment ;
    rdfs:range fair:FAIR-SubPrinciple .

map:alignmentBasis a owl:AnnotationProperty ;
    rdfs:label "alignment basis"@en .

map:alignmentType a owl:AnnotationProperty ;
    rdfs:label "alignment type"@en .

map:applicabilityCondition a owl:AnnotationProperty .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/direct/R1> a owl:NamedIndividual,
        map:AreaAlignmentAssessment ;
    rdfs:label "Big Data & Data Science → R1 (Direct)"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA_FAIR_Sankey_v1.3.0.zip> ;
    map:alignedPrinciple fair:R1 ;
    map:alignmentBasis "Activity-derived proposal (additional topic)"@en ;
    map:alignmentType "Direct" ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Data Analysis and Hypotheses"@en ;
    map:derivedFromActivity <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-6> ;
    map:fromTopic dama:BigDataAndDataScience ;
    map:rationale "Inferred potential direct support: documented hypotheses and methods can supply accurate, relevant methodological context for reusing the associated analytical data. The diagram does not establish that these descriptions are complete or associated with identifiable resources."@en .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#area-alignment/big-data-data-science/indirect/A1> a owl:NamedIndividual,
