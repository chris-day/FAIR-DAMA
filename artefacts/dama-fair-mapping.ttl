<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/DataHandlingEthics/row-8> a owl:NamedIndividual,
        map:SourceActivity ;
    rdfs:label "Implement Monitoring Plan"@en ;
    dcterms:identifier "DataHandlingEthics!A8:L8" ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMAV2Images/01_DataHandlingEthics.webp>,
        <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#DataHandlingEthics!A8:L8> ;
    map:alignmentBasis "Activity-derived proposal; source image plus interpreted associations"@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:deliverables "Ethical Data Handling Reporting; Aligned Incentives, KPIs, and Targets"@en ;
