    map:rationale "Integration can preserve provenance and implement explicit semantic representations and typed links when these requirements are included in the integration design."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Explore Data Using Models → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A8:L8> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    map:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    map:targetsPrinciple fair:R1 ;
    map:viaPractice map:PublishRichReuseDescriptions .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-8/indirect/R1.2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Explore Data Using Models → R1.2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A8:L8> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect resource-linked descriptions of analytical context and limitations and a traceable execution record linking inputs, model versions and outputs. Performance scores alone are insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-8> ;
    map:rationale "Exploration can enrich reuse descriptions and provenance if assumptions, limitations, source versions, model versions and analytical steps are recorded with the resulting resources."@en ;
    map:targetsPrinciple fair:R1.2 ;
    map:viaPractice map:PublishProvenance .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-9/indirect/F2> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Communicate Output to Stakeholders → F2"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A9:L9> ;
    map:alignmentBasis "Activity-derived proposal"@en ;
    map:applicabilityCondition "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    map:assessmentStatus "Proposed; no implementation or compliance asserted"@en ;
    map:evidenceRequirement "Inspect resource-linked discovery and reuse descriptions covering meaning, methods, coverage, assumptions and limitations. A presentation without associated resource descriptions is insufficient."@en ;
    map:fromPractice <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#activity/BigDataDataScience/row-9> ;
    map:rationale "Communications can make discovery and reuse context available if findings are accompanied by accurate descriptions linked to the analytical resources."@en ;
    map:targetsPrinciple fair:F2 ;
    map:viaPractice map:PublishRichDiscoveryMetadata .

<https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/dama-fair-mapping.ttl#contribution/BigDataDataScience/row-9/indirect/R1> a owl:NamedIndividual,
        map:IndirectContribution ;
    rdfs:label "Communicate Output to Stakeholders → R1"@en ;
    dcterms:source <https://github.com/chris-day/FAIR-DAMA/blob/main/artefacts/DAMA-PDOC_FAIR-MASTER_2026-11-16_V3.xlsx#BigDataDataScience!A9:L9> ;
