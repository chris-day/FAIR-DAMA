# Populated from the published persona table. Load with the DAMA and FAIR vocabularies.
@prefix dama: <https://example.org/dama/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fair: <https://w3id.org/fair/principles/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix persona: <https://example.org/dama-persona/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

<https://orcid.org/0000-0001-5095-7052> rdfs:label "Chris Day"@en .

<https://example.org/dama-persona/ontology> a owl:Ontology ;
    dcterms:creator <https://orcid.org/0000-0001-5095-7052> ;
    dcterms:source <https://fair-dama.perdl.com/dama/personas/> ;
    dcterms:title "DAMA Persona Ontology"@en .

persona:concernsPractice a owl:ObjectProperty ;
    rdfs:domain persona:Responsibility ;
    rdfs:range <https://example.org/dama-fair/terms/Practice> .

persona:consumerIn a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:SourceTopic .

persona:correspondsToKnowledgeArea a owl:ObjectProperty ;
    rdfs:domain persona:SourceTopic ;
    rdfs:range dama:KnowledgeArea .

persona:hasGoal a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:Goal .

persona:hasResponsibility a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:Responsibility .

persona:participantIn a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:SourceTopic .

