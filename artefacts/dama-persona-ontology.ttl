persona:reportedDirectFAIRPrinciple a owl:ObjectProperty ;
    rdfs:comment "Direct FAIR relationship reported in the persona table."@en ;
    rdfs:domain persona:Persona ;
    rdfs:range fair:FAIR-SubPrinciple .

persona:reportedIndirectFAIRPrinciple a owl:ObjectProperty ;
    rdfs:comment "Indirect FAIR relationship reported in the persona table. The table does not specify an intermediate practice."@en ;
    rdfs:domain persona:Persona ;
    rdfs:range fair:FAIR-SubPrinciple .

persona:representsRole a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:Role .

persona:supplierIn a owl:ObjectProperty ;
    rdfs:domain persona:Persona ;
    rdfs:range persona:SourceTopic .

persona:Goal a owl:Class .

persona:Role a owl:Class .

