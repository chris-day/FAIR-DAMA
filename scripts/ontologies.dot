digraph Ontologies {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.45", ranksep="0.8"];
  node [shape=box, style="rounded,filled", fillcolor="#f3f7fc", color="#45617c", fontname="Arial", fontsize=11];
  edge [color="#45617c", fontname="Arial", fontsize=9, arrowsize=0.7];
  Persona [label="Persona\n123 source names"];
  SourceTopic [label="Document source topic\n15 numbered sections"];
  Core [label="Core knowledge area\n11 unchanged"];
  Extra [label="Additional topic\nBig Data; Ethics; Maturity"];
  Activity [label="Source activity\n16 new rows"];
  Practice [label="Evidence-producing practice"];
  Contribution [label="Practice contribution\n9 examples + 31 activity assertions"];
  AreaProposal [label="Area alignment assessment\n74 Sankey records"];
  FAIR [label="FAIR principles\n15 numbered IDs"];
  Topic [label="Management topic\nCore area or additional topic"];
  Persona -> SourceTopic [label="supplierIn / participantIn / consumerIn"];
  SourceTopic -> Core [label="correspondsToKnowledgeArea"];
  SourceTopic -> Extra [label="correspondsToTopic"];
  Activity -> Extra [label="inTopic"];
  Activity -> Persona [style=dashed, label="proposed activity roles"];
  Contribution -> Activity [label="fromPractice (new activity assertions)"];
  Contribution -> FAIR [label="targetsPrinciple"];
  Contribution -> Practice [style=dashed, label="viaPractice (indirect)"];
  Practice -> FAIR [label="evidenceForPrinciple"];
  AreaProposal -> Topic [label="fromTopic"];
  AreaProposal -> FAIR [label="alignedPrinciple"];
  AreaProposal -> Activity [style=dashed, label="derivedFromActivity (new topics)"];
  Persona -> FAIR [style=dashed, label="reported direct / indirect area-derived links"];
}
